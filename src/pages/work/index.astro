---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery';
import { getCollection } from 'astro:content';

const works = await getCollection('work');
const sortedWorks = works.sort((a, b) => {
  const parseDate = (d: string) => {
    const [month, year] = d.split('/');
    return new Date(parseInt(year), parseInt(month) - 1);
  };
  return parseDate(b.data.date).getTime() - parseDate(a.data.date).getTime();
});

const projects = sortedWorks.map(work => ({
  id: work.id,
  title: work.data.title,
  date: work.data.date,
  category: work.data.category,
  thumbnail: work.data.thumbnail,
  description: work.data.description,
}));

const categories = [...new Set(works.map(w => w.data.category))].sort();
---

<BaseLayout title="Work — Joshua Nghe">
  <section class="work-page section">
    <div class="container">
      <header class="work-page__header">
        <h1 class="work-page__title">Selected Work</h1>
        <p class="work-page__subtitle">Projects across data science, statistics, and design.</p>
      </header>

      <Gallery projects={projects} categories={categories} client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .work-page__header {
    margin-bottom: 3rem;
  }

  .work-page__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .work-page__subtitle {
    font-size: 1rem;
    color: var(--text-muted);
  }
</style>

<style is:global>
  /* Gallery component styles */
  .gallery__filters {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .gallery__filter-btn {
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-family: inherit;
    cursor: pointer;
    transition: all var(--transition);
  }

  .gallery__filter-btn:hover {
    border-color: var(--text-muted);
    color: var(--text);
  }

  .gallery__filter-btn.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 2rem;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-lg);
    transition: transform var(--transition);
  }

  .gallery-card:hover {
    opacity: 1;
  }

  .gallery-card__image-wrap {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .gallery-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-card__info {
    padding: 0.25rem;
  }

  .gallery-card__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }

  .gallery-card__title {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--text);
  }

  .gallery-card__date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .gallery-card__desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .gallery-card__category {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .gallery__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
