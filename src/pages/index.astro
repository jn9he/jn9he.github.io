---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGallery from '../components/HeroGallery';
import { getCollection } from 'astro:content';

const works = await getCollection('work');
const sortedWorks = works.sort((a, b) => {
  const parseDate = (d: string) => {
    const [month, year] = d.split('/');
    return new Date(parseInt(year), parseInt(month) - 1);
  };
  return parseDate(b.data.date).getTime() - parseDate(a.data.date).getTime();
});

const projects = sortedWorks.map(work => ({
  id: work.id,
  title: work.data.title,
  date: work.data.date,
  category: work.data.category,
  thumbnail: work.data.thumbnail,
}));
---

<BaseLayout title="Joshua Nghe — Portfolio">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__name">Joshua Nghe</h1>
        <p class="hero__tagline">Statistics · Data Science · Design</p>
      </div>
    </div>
  </section>

  <!-- Horizontal Scroll Gallery -->
  <section class="gallery-section">
    <div class="container">
      <p class="gallery-section__label">Selected Work</p>
    </div>
    <HeroGallery projects={projects} client:visible />
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: flex;
    align-items: center;
    min-height: calc(60vh - var(--nav-height));
    padding: clamp(4rem, 12vh, 8rem) 0;
  }

  .hero__content {
    max-width: 800px;
  }

  .hero__name {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero__tagline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-muted);
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  /* Gallery Section */
  .gallery-section {
    padding-bottom: clamp(4rem, 10vh, 8rem);
  }

  .gallery-section__label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
</style>

<style is:global>
  /* HeroGallery component styles */
  .hero-gallery {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hero-gallery::-webkit-scrollbar {
    display: none;
  }

  .hero-gallery__track {
    display: flex;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }

  .hero-gallery__card {
    flex-shrink: 0;
    width: clamp(280px, 30vw, 380px);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .hero-gallery__card:hover {
    opacity: 1;
  }

  .hero-gallery__image-wrap {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .hero-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-gallery__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0.25rem;
  }

  .hero-gallery__title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text);
  }

  .hero-gallery__date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
