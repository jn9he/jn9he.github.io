---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkSection from '../components/WorkSection';
import { getCollection } from 'astro:content';

const works = await getCollection('work');
const sortedWorks = works.sort((a, b) => {
  const parseDate = (d: string) => {
    const [month, year] = d.split('/');
    return new Date(parseInt(year), parseInt(month) - 1);
  };
  return parseDate(b.data.date).getTime() - parseDate(a.data.date).getTime();
});

const projects = sortedWorks.map(work => ({
  id: work.id,
  title: work.data.title,
  date: work.data.date,
  category: work.data.category,
  thumbnail: work.data.thumbnail,
}));

const categories = [...new Set(works.map(w => w.data.category))].sort();
---

<BaseLayout title="Joshua Nghe — Portfolio">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="hero__content">
        <h1 class="hero__name">Joshua Nghe</h1>
        <p class="hero__tagline">Specializing in statistical modeling, data science, and visual design — collaborating with teams to turn data into decisions.</p>
      </div>
    </div>
  </section>

  <!-- Seasons-style Project List -->
  <section class="projects-section">
    <div class="container">
      <p class="projects-section__label">Selected Work</p>
    </div>
    <div class="container">
      <WorkSection projects={projects} categories={categories} client:load />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    display: flex;
    align-items: center;
    min-height: calc(50vh - var(--nav-height));
    padding: clamp(6rem, 15vh, 12rem) 0 clamp(3rem, 6vh, 5rem);
  }

  .hero__content {
    max-width: 700px;
  }

  .hero__name {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.0;
    margin-bottom: 1.5rem;
  }

  .hero__tagline {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--text-secondary);
    font-weight: 300;
    line-height: 1.6;
    max-width: 540px;
  }

  /* Projects Section */
  .projects-section {
    padding-bottom: clamp(6rem, 12vh, 10rem);
  }

  .projects-section__label {
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
</style>
