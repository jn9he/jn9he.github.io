---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Joshua Nghe">
  <section class="not-found">
    <div class="container">
      <h1 class="not-found__code">404</h1>
      <p class="not-found__message">This page doesn't exist.</p>
      <a href="/" class="not-found__link">← Back to Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(70vh - var(--nav-height));
    text-align: center;
  }

  .not-found__code {
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 300;
    letter-spacing: -0.05em;
    color: var(--text-muted);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .not-found__message {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .not-found__link {
    font-size: 0.95rem;
    color: var(--text);
    font-weight: 500;
    transition: opacity var(--transition);
  }

  .not-found__link:hover {
    opacity: 0.7;
  }
</style>
