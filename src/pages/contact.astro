---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal';
---

<BaseLayout title="Contact — Joshua Nghe">
  <section class="contact section">
    <div class="container">
      <ScrollReveal client:visible>
        <header class="contact__header">
          <h1 class="contact__title">Get in Touch</h1>
          <p class="contact__intro">
            I'm open to collaborations, opportunities, and interesting conversations. Reach out through any of the channels below.
          </p>
        </header>
      </ScrollReveal>

      <ScrollReveal delay={0.2} client:visible>
        <div class="contact__links">
          <a href="https://github.com/jn9he" target="_blank" rel="noopener noreferrer" class="contact__link-item">
            <span class="contact__link-label">GitHub</span>
            <span class="contact__link-value">github.com/jn9he</span>
            <svg class="contact__link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>

          <a href="https://linkedin.com/in/" target="_blank" rel="noopener noreferrer" class="contact__link-item">
            <span class="contact__link-label">LinkedIn</span>
            <span class="contact__link-value">linkedin.com/in/joshuanghe</span>
            <svg class="contact__link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>

          <a href="mailto:hello@jn9he.github.io" class="contact__link-item">
            <span class="contact__link-label">Email</span>
            <span class="contact__link-value">hello@jn9he.github.io</span>
            <svg class="contact__link-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        </div>
      </ScrollReveal>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    max-width: 720px;
    margin: 0 auto;
  }

  .contact__header {
    margin-bottom: 4rem;
  }

  .contact__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .contact__intro {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 520px;
  }

  .contact__links {
    display: flex;
    flex-direction: column;
  }

  .contact__link-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition);
  }

  .contact__link-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .contact__link-item:hover {
    opacity: 1;
    padding-left: 0.5rem;
  }

  .contact__link-item:hover .contact__link-arrow {
    transform: translate(3px, -3px);
  }

  .contact__link-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    font-weight: 500;
    min-width: 80px;
  }

  .contact__link-value {
    font-size: 1rem;
    color: var(--text);
    flex: 1;
  }

  .contact__link-arrow {
    color: var(--text-muted);
    transition: transform var(--transition);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .contact__link-item {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .contact__link-label {
      min-width: 100%;
    }
  }
</style>
