---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal';
import AboutGallery from '../components/AboutGallery.astro';
const galleryImages = [
  {
    src: '/images/gallery_images/pfp_2.jpg',
    alt: 'Joshua at a venue with a blue-lit stage',
    caption: 'Jazz  concert in Pennington',
  },
  {
    src: '/images/gallery_images/IMG_6810.jpg',
    alt: 'Snow-covered mountains viewed from a ski slope',
    caption: 'North Park, CO',
  },
    {
    src: '/images/gallery_images/IMG_1506.jpeg',
    alt: 'Joshua at a historic outdoor exhibit',
    caption: 'Laser Cut Artwork',
  },
    {
    src: '/images/gallery_images/IMG_0936.jpeg',
    alt: 'Joshua at a historic outdoor exhibit',
    caption: 'Kailua, HI',
  },
  {
    src: '/images/gallery_images/F0711639-E55D-4527-81DA-6B234DCD3028.JPG',
    alt: 'Smallmouth bass caught while fishing',
    caption: 'Chasing Smallmouth',
  },
  {
    src: '/images/gallery_images/IMG_2387_Original.jpeg',
    alt: 'Green mountain landscape with Joshua on a trail',
    caption: 'Crested Butte, CO',
  },

  {
    src: '/images/gallery_images/IMG_1770_Original.JPG',
    alt: 'Joshua at a historic outdoor exhibit',
    caption: 'Rothko at the MOMA',
  },


];
---

<BaseLayout title="About — Joshua Nghe">
  <section class="about section">
    <div class="container">
      <ScrollReveal client:visible>
        <header class="about__header">
          <img class="about__portrait" src="/images/pfp_bw.jpg?v=2" alt="Joshua Nghe" loading="eager" />
          <h1 class="about__title">About Me</h1>
        </header>
      </ScrollReveal>

      <div class="about__content">
        <ScrollReveal delay={0.1} client:visible>
          <p class="about__lead">
            I'm <strong>Joshua Nghe</strong>, a statistics undergraduate that likes to build.
          </p>
        </ScrollReveal>

        <ScrollReveal delay={0.2} client:visible>
          <p>
            Including my previous experience at Spectrum as a Data Analyst intern in customer operations, I have 1+ years experience in tutoring whether it be privately, through TA position, or at the Colorado State Statistics
            Success Center. I'm fascinated by the potential of math and computer science as it's methodologies are applied to a variety of fields.


          </p>
        </ScrollReveal>

        <ScrollReveal delay={0.3} client:visible>
          <p>
           My personal interests include alernative music, working out, and the outdoors. I love to stay active and an appreciation for all things beautiful from nature and wildlife to music, artwork, or street skateboarding.
          </p>
        </ScrollReveal>
        <ScrollReveal delay={0.4} client:visible>
          <div class="about__details">
            <div class="about__detail-group">
              <h3>Focus Areas</h3>
              <ul>
                <li>Statistical Modeling & Inference</li>
                <li>Machine Learning & Prediction</li>
                <li>Data Visualization & Design</li>
                <li>Experimental Design & A/B Testing</li>
              </ul>
            </div>

            <div class="about__detail-group">
              <h3>Prospective Fields of Interest</h3>
              <ul>
                <li>Sports, Entertainment, Environmental Analytics</li>
                <li>Fashion Research and Manufacturing</li>
                <li>Financial Analysis and Modeling</li>
              </ul>
            </div>

            <div class="about__detail-group">
              <h3>Tools</h3>
              <ul>
                <li>R · Python · SQL</li>
                <li>tidyverse · scikit-learn · PyTorch</li>
                <li>Microsoft 365 Ecosystem/li>
                <li>Rhino 3D · Photoshop · FL Studio</li>
              </ul>
            </div>
          </div>
        </ScrollReveal>

        <ScrollReveal delay={0.5} client:visible>
          <div class="about__cta">
            <p>If you'd like to contact me, I'm always open for a chat.</p>
            <a href="/contact" class="about__link">Get in touch →</a>
          </div>
        </ScrollReveal>
      </div>

      <section class="about__gallery-section" aria-labelledby="about-gallery-title">
        <h2 class="visually-hidden" id="about-gallery-title">Photo gallery</h2>
        <AboutGallery images={galleryImages} />
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 720px;
    margin: 0 auto;
  }

  .about__header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .about__portrait {
    width: clamp(88px, 16vw, 140px);
    height: clamp(88px, 16vw, 140px);
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }

  .about__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .about__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about__gallery-section {
    margin-top: clamp(4rem, 9vw, 7rem);
    position: relative;
    left: 50%;
    width: min(1100px, calc(100vw - 3rem));
    transform: translateX(-50%);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .about__lead {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about__lead strong {
    color: var(--text);
    font-weight: 500;
  }

  .about__content p {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .about__details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .about__detail-group h3 {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .about__detail-group ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about__detail-group li {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .about__cta {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .about__cta p {
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .about__link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    transition: opacity var(--transition);
  }

  .about__link:hover {
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .about__header {
      align-items: flex-start;
      gap: 1rem;
    }

    .about__portrait {
      width: 76px;
      height: 76px;
    }

    .about__title {
      font-size: clamp(2.2rem, 9vw, 3rem);
      padding-top: 0.5rem;
    }

    .about__details {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
